# ─── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── MongoDB Atlas (get free at mongodb.com/atlas) ────────
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/lexassist

# ─── JWT (use any random string, min 32 chars) ────────────
JWT_SECRET=replace_with_random_32_char_string_here
JWT_EXPIRES_IN=7d

# ─── Session (use any random string) ──────────────────────
SESSION_SECRET=replace_with_another_random_string_here

# ─── OpenAI (OPTIONAL - chatbot works without it) ─────────
# Get free key at platform.openai.com
OPENAI_API_KEY=sk-your_key_here

# ─── Gmail (for email notifications) ──────────────────────
# Gmail → Security → App Passwords → Generate 16-char password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_16_char_app_password_here

# ─── Frontend URL (your Railway URL after deploy) ─────────
CLIENT_URL=https://your-app-name.up.railway.app
